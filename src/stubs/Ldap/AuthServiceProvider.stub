<?php

namespace App\Providers;

use DB;
use Illuminate\Http\Request;
use Laravel\Fortify\Fortify;
use Illuminate\Support\Facades\Auth;
use Illuminate\Foundation\Support\Providers\AuthServiceProvider as ServiceProvider;

use App\Models\User as U;
use Icebearsoft\Kitukizuri\App\Models\Modulo;
use Icebearsoft\Kitukizuri\App\Models\Empresa;
use Icebearsoft\Kitukizuri\App\Models\UsuarioRol;
use Icebearsoft\Kitukizuri\App\Models\ModuloEmpresas;

class AuthServiceProvider extends ServiceProvider
{
    /**
     * The model to policy mappings for the application.
     *
     * @var array<class-string, class-string>
     */
    protected $policies = [
        //
    ];

    /**
     * Register any authentication / authorization services.
     */
    public function boot(): void
    {
        $this->registerPolicies();

        // Passkeys belongs to the local Eloquent user, not the directory model.
        if (class_exists(\Laravel\Passkeys\Passkeys::class)) {
            \Laravel\Passkeys\Passkeys::useUserModel(U::class);
        }

        Fortify::authenticateUsing(function (Request $request): ?U {
            $validated = Auth::validate([
                'mail' => $request->email,
                'password' => $request->password,
            ]);

            $user = Auth::getLastAttempted();

            if ($validated === true && $user instanceof U) {
                $this->setEmpresaRol($user);

                return $user;
            }

            return null;
        });
    }

    private function setEmpresaRol(U $user): void
    {
        if ($user->empresaid === null) {
            $ldapUserData = $user->ldap;
            $company = $ldapUserData?->getFirstAttribute('company') ?: config('app.name', 'Empresa');

            $empresa = Empresa::firstOrCreate([
                'nombre' => $company,
            ]);

            $userData = U::find($user->id);
            $userData->empresaid = $empresa->empresaid;
            $userData->save();

            $modulos = Modulo::select(DB::raw($empresa->empresaid.' as empresaid'), 'moduloid')
                ->whereNotIn('moduloid', function ($query) use ($empresa) {
                    $query->select('moduloid')
                        ->from('moduloEmpresas')
                        ->where('empresaid', $empresa->empresaid);
                })
                ->get()
                ->toArray();

            if (!empty($modulos)) {
                ModuloEmpresas::insert($modulos);
            }
        }

        $roles = UsuarioRol::where('usuarioid', $user->id)->pluck('rolid')->toArray();
        if (empty($roles)) {
            $rolId = (int) env('LDAP_DEFAULT_ROLE_ID', 2);
            $usuarioRol = new UsuarioRol;
            $usuarioRol->rolid = $rolId;
            $usuarioRol->usuarioid = $user->id;
            $usuarioRol->save();

            $roles = [$rolId];
        }

        foreach ($roles as $rolId) {
            $this->ensureDefaultRoleCanAccessDashboard((int) $rolId);
        }
    }

    private function ensureDefaultRoleCanAccessDashboard(int $rolId): void
    {
        $moduloPermisos = DB::table('moduloPermiso as mp')
            ->join('modulos as m', 'm.moduloid', '=', 'mp.moduloid')
            ->whereIn('m.ruta', ['home', 'dashboard'])
            ->where('mp.permisoid', 2)
            ->pluck('mp.modulopermisoid')
            ->toArray();

        foreach ($moduloPermisos as $moduloPermisoId) {
            DB::table('rolModuloPermiso')->updateOrInsert([
                'rolid' => $rolId,
                'modulopermisoid' => $moduloPermisoId,
            ], [
                'created_at' => now(),
                'updated_at' => now(),
            ]);
        }
    }
}
