{
    "name": "icebearsoft/kitukizuri-mcp",
    "description": "Opt-in dynamic Laravel MCP tools for Kitukizuri resources",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "icebearsoft/kitukizuri": "@dev",
        "laravel/mcp": "~0.9.4",
        "illuminate/database": "^12.41.1",
        "illuminate/support": "^12.41.1"
    },
    "require-dev": {
        "orchestra/testbench": "^10.8",
        "phpunit/phpunit": "^11.5"
    },
    "repositories": [{"type": "path", "url": "../..", "options": {"symlink": true}}],
    "autoload": {"psr-4": {"Icebearsoft\\Kitukizuri\\Mcp\\": "src/"}},
    "autoload-dev": {"psr-4": {"Icebearsoft\\Kitukizuri\\Mcp\\Tests\\": "tests/"}},
    "extra": {"laravel": {"providers": ["Icebearsoft\\Kitukizuri\\Mcp\\McpServiceProvider"]}},
    "scripts": {"test": "phpunit"},
    "config": {"allow-plugins": false, "sort-packages": true},
    "minimum-stability": "stable",
    "prefer-stable": true
}
